# Stage 9/10 LLM configuration template.
# Copy this file to ".env" in the same folder when you are ready to test a real LLM.
# Keep ".env" private. The repository-level .gitignore already excludes it.

# Default provider routing: DeepSeek V4.
# The client sends an OpenAI-compatible chat-completions request body and keeps
# offline fallback active when the API key is missing.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_API_STYLE=openai_compatible

# DeepSeek credentials and endpoint.
# Fill your real DeepSeek API key on the line below in your private ".env" file.
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions

# Optional provider-neutral aliases for later non-DeepSeek providers.
LLM_API_KEY=
LLM_API_ENDPOINT=

# Optional MiniMax text settings kept only for future provider switching.
MINIMAX_API_KEY=
MINIMAX_API_ENDPOINT=https://api.minimax.io/v1/chat/completions

# Stage 11 image generation settings.
# MiniMax's image endpoint can be used with --image-mode auto/online.
IMAGE_PROVIDER=minimax
IMAGE_MODEL=image-01
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_ENDPOINT=https://api.minimaxi.com/v1/image_generation
IMAGE_API_ENDPOINT=
IMAGE_API_KEY=
IMAGE_ASPECT_RATIO=16:9
IMAGE_RESPONSE_FORMAT=base64
IMAGE_TIMEOUT_SECONDS=90
IMAGE_MAX_RETRIES=1
IMAGE_RETRY_BACKOFF_SECONDS=2.0
IMAGE_PROMPT_OPTIMIZER=true
IMAGE_FORCE_OFFLINE=false
IMAGE_FALLBACK_ON_ERROR=true

# Runtime behavior.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Safety switches.
# true: always skip API calls and use deterministic fallback JSON.
# false: call the API only when the key and endpoint are present.
LLM_FORCE_OFFLINE=false

# true: if an online call fails or returns invalid JSON, continue with fallback JSON.
LLM_FALLBACK_ON_ERROR=true
