# Local LLM runtime configuration.
# This file is for your private API settings and should not be committed.

# Provider routing.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_API_STYLE=openai_compatible

# Fill your real deepseek API key on the line below.
DEEPSEEK_API_KEY= sk-e29ed56df9214db4818f660727be9332

# Official deepseek OpenAI-compatible chat endpoint.
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions

# Optional generic aliases. Leave blank unless you switch to another provider later.
LLM_API_KEY=
LLM_API_ENDPOINT=

# Runtime behavior.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Safety switches.
# Set this to true only when you want to force offline fallback.
LLM_FORCE_OFFLINE=false

# Keep this true during testing so a failed API call does not break the workflow.
LLM_FALLBACK_ON_ERROR=true
